# Copy this file to .env and put your real key in it.
# scripts\setup.ps1 does both for you (the key is typed in hidden, never echoed).
# .env is git-ignored; this example file contains placeholders only.

# --- Required ---
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here

# --- Claude settings (defaults shown) ---
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# on | off : automatic server-side retry on a fallback model if a request is declined
ANTHROPIC_FALLBACKS=on
# on | off : short progress notes from Claude between tool calls, shown in the CLI
ANTHROPIC_PROGRESS_UPDATES=on
# Seconds to wait for one Claude API response (10-900)
ANTHROPIC_TIMEOUT_SECS=300

# --- Guardrails ---
# Claude calls allowed per user request (1-50)
MAX_ITERATIONS=8
# Default per-tool timeout in seconds (1-300)
TOOL_TIMEOUT_SECS=10
# Optional per-tool timeouts (seconds), comma-separated
# TOOL_TIMEOUT_OVERRIDES=files__search_files=30,telemetry__search_logs=5

# --- Telemetry data ---
# "Now" for time-window queries; the seed data is built around this instant.
# Set to: now   to use the real clock instead.
OPS_REFERENCE_TIME=2026-11-20T12:00:00Z

# --- Diagnostics (stderr). trace | debug | info | warn | error ---
LOG_LEVEL=warn

# --- Paths (optional; relative to the project folder) ---
# TELEMETRY_SERVER_PATH=target\debug\ops-telemetry-mcp.exe
# FILESYSTEM_ROOT=mock_data\workspace
# TRACE_FILE=traces\agent_traces.jsonl

# --- MCP servers (optional) ---
# Seconds a server may take to start and finish the MCP handshake (1-120)
# MCP_STARTUP_TIMEOUT_SECS=20
# Node.js executable for the filesystem server (default: node from PATH)
# NODE_EXE=node
# FILESYSTEM_SERVER_SCRIPT=node_modules\@modelcontextprotocol\server-filesystem\dist\index.js
# SQLite file for incident tickets (created on first ticket)
# TICKETS_DB=data\tickets.db
