# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# ---- Build output / dependencies ----
/target/
/node_modules/
**/target/
**/node_modules/
*.tgz

# ---- Runtime data (created when the agent runs) ----
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
/traces/agent_traces.jsonl
/evals/results/*
!/evals/results/.gitkeep
*.log

# ---- Assignment brief (company document; keep out of a public repo) ----
/Intern Assignment 2.pdf

# ---- Editor / OS noise (shared VS Code recommendations ARE committed) ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
Thumbs.db
desktop.ini
.DS_Store
